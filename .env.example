# 灵小禅可信文旅助手 - 环境配置模板
# 使用前请将下方的 your-xxx-here 替换为您的真实 API Key

# DeepSeek API（主力文本模型）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Agnes AI（备用文本模型）
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# 服务器配置
PORT=8010
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:8010

# 安全配置
SECRET_KEY=
# 首次登录前填写；已存在管理员配置时不会覆盖已有密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional OpenAI-compatible vision provider; never commit actual credentials
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
