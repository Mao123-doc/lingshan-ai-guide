/** evidence-drawer.wxss **/

.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: fadeIn 0.22s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.drawer-content {
  background: #ffffff;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.12);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.drawer-header {
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
}

.drawer-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.drawer-close {
  color: var(--ink-muted);
  padding: 8rpx;
  display: flex;
  align-items: center;
  cursor: pointer;
}

.drawer-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 14rpx;
}

.meta-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.tag-model {
  background: #fff1f2;
  color: #9d174d;
  border: 1rpx solid #fecdd3;
}

.tag-kb {
  background: #f0fdf4;
  color: #15803d;
  border: 1rpx solid #bbf7d0;
}

.meta-text {
  font-size: 22rpx;
  color: var(--ink-muted);
}

.drawer-note {
  font-size: 20rpx;
  color: var(--ink-muted);
  line-height: 1.5;
  background: #f8fafc;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #f1f5f9;
}

.drawer-scroll {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 56vh;
  box-sizing: border-box;
}

.evidence-card {
  background: #faf8f5;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-xs);
}

.evidence-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.evidence-source {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.evidence-score {
  font-size: 20rpx;
  color: #9d174d;
  background: #fff1f2;
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
  font-weight: 600;
  border: 1rpx solid #fecdd3;
}

.evidence-body {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.65;
}

.evidence-empty {
  text-align: center;
  padding: 60rpx 20rpx;
  color: var(--ink-muted);
  font-size: 26rpx;
}
