/** digital-human.wxss **/

.dh-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}

/* 尺寸预设 */
.dh-mini .dh-avatar-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.dh-normal .dh-avatar-wrap {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
}

.dh-large .dh-avatar-wrap {
  width: 216rpx;
  height: 216rpx;
  border-radius: 50%;
}

/* 风格色系变量（东方传统色） */
.dh-zen_red_gold {
  --primary-color: #8f202e;
  --glow-color: rgba(143, 32, 46, 0.18);
  --ring-color: rgba(184, 134, 54, 0.45);
}

.dh-celadon_elegance {
  --primary-color: #2d5a4c;
  --glow-color: rgba(45, 90, 76, 0.18);
  --ring-color: rgba(45, 90, 76, 0.45);
}

.dh-tang_splendor {
  --primary-color: #b88636;
  --glow-color: rgba(184, 134, 54, 0.18);
  --ring-color: rgba(206, 159, 79, 0.45);
}

.dh-ink_wash {
  --primary-color: #44403c;
  --glow-color: rgba(68, 64, 60, 0.18);
  --ring-color: rgba(120, 113, 108, 0.45);
}

/* 肖像外框与呼吸微动效 */
.dh-avatar-wrap {
  position: relative;
  overflow: hidden;
  border: 3.5rpx solid var(--primary-color, #8f202e);
  box-shadow: 0 6rpx 20rpx var(--glow-color, rgba(143, 32, 46, 0.18));
  background: #ffffff;
  z-index: 2;
  transition: transform 0.3s ease;
  animation: dhBreath 4s ease-in-out infinite;
}

@keyframes dhBreath {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

.dh-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 氛围光环 */
.dh-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 125%;
  height: 125%;
  border-radius: 50%;
  background: radial-gradient(circle, var(--glow-color, rgba(143, 32, 46, 0.2)) 0%, transparent 70%);
  z-index: 1;
  pointer-events: none;
}

/* 播报中光环脉冲 */
.dh-speaking .dh-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 115%;
  height: 115%;
  border-radius: 50%;
  border: 2rpx solid var(--ring-color, rgba(184, 134, 54, 0.45));
  z-index: 1;
  animation: ringPulse 2s infinite ease-out;
  pointer-events: none;
}

@keyframes ringPulse {
  0% {
    transform: translate(-50%, -50%) scale(0.96);
    opacity: 0.8;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.3);
    opacity: 0;
  }
}

/* 播报音浪跳动柱条 */
.dh-sound-bars {
  position: absolute;
  top: -24rpx;
  display: flex;
  gap: 6rpx;
  align-items: flex-end;
  height: 24rpx;
  z-index: 3;
}

.dh-bar {
  width: 6rpx;
  background: var(--primary-color, #8f202e);
  border-radius: 4rpx;
  animation: barWave 0.9s ease-in-out infinite alternate;
}

.bar-1 { height: 10rpx; animation-delay: 0.1s; }
.bar-2 { height: 20rpx; animation-delay: 0.3s; }
.bar-3 { height: 14rpx; animation-delay: 0.5s; }
.bar-4 { height: 22rpx; animation-delay: 0.2s; }
.bar-5 { height: 12rpx; animation-delay: 0.4s; }

@keyframes barWave {
  0% { height: 6rpx; }
  100% { height: 24rpx; }
}

/* 状态徽标 */
.dh-badge {
  position: absolute;
  bottom: 24rpx;
  right: 6rpx;
  background: #ffffff;
  border-radius: 50%;
  padding: 4rpx;
  box-shadow: 0 4rpx 10rpx rgba(44, 38, 34, 0.1);
  z-index: 4;
}

.dh-badge-inner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  background: var(--bg-page);
  color: var(--primary-color, #8f202e);
}

/* 状态提示文字 */
.dh-status-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  max-width: 360rpx;
  line-height: 1.4;
}
