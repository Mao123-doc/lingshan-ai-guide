/** digital-human.wxss **/

.dh-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}

/* 尺寸预设 */
.dh-mini .dh-avatar-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.dh-normal .dh-avatar-wrap {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
}

.dh-large .dh-avatar-wrap {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
}

/* 风格色系变量 */
.dh-zen_red_gold {
  --primary-color: #9d174d;
  --glow-color: rgba(157, 23, 77, 0.25);
  --ring-color: rgba(190, 24, 93, 0.45);
}

.dh-celadon_elegance {
  --primary-color: #0f766e;
  --glow-color: rgba(15, 118, 110, 0.25);
  --ring-color: rgba(20, 184, 166, 0.45);
}

.dh-tang_splendor {
  --primary-color: #b45309;
  --glow-color: rgba(180, 83, 9, 0.25);
  --ring-color: rgba(217, 119, 6, 0.45);
}

.dh-ink_wash {
  --primary-color: #334155;
  --glow-color: rgba(51, 65, 85, 0.25);
  --ring-color: rgba(71, 85, 105, 0.45);
}

/* 肖像外框与呼吸微动效 */
.dh-avatar-wrap {
  position: relative;
  overflow: hidden;
  border: 4rpx solid var(--primary-color, #9d174d);
  box-shadow: 0 8rpx 24rpx var(--glow-color, rgba(157, 23, 77, 0.25));
  background: #ffffff;
  z-index: 2;
  transition: transform 0.3s ease;
  animation: dhBreath 4s ease-in-out infinite;
}

@keyframes dhBreath {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.025);
  }
}

.dh-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 氛围光环 */
.dh-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 130%;
  height: 130%;
  border-radius: 50%;
  background: radial-gradient(circle, var(--glow-color, rgba(157, 23, 77, 0.3)) 0%, transparent 70%);
  z-index: 1;
  pointer-events: none;
}

/* 播报中光环脉冲 */
.dh-speaking .dh-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 115%;
  height: 115%;
  border-radius: 50%;
  border: 3rpx solid var(--ring-color, rgba(190, 24, 93, 0.5));
  z-index: 1;
  animation: ringPulse 1.8s infinite;
  pointer-events: none;
}

@keyframes ringPulse {
  0% {
    transform: translate(-50%, -50%) scale(0.96);
    opacity: 0.8;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.35);
    opacity: 0;
  }
}

/* 播报音浪跳动柱条 */
.dh-sound-bars {
  position: absolute;
  top: -24rpx;
  display: flex;
  gap: 6rpx;
  align-items: flex-end;
  height: 24rpx;
  z-index: 3;
}

.dh-bar {
  width: 6rpx;
  background: var(--primary-color, #9d174d);
  border-radius: 4rpx;
  animation: barWave 0.9s ease-in-out infinite alternate;
}

.bar-1 { height: 10rpx; animation-delay: 0.1s; }
.bar-2 { height: 20rpx; animation-delay: 0.3s; }
.bar-3 { height: 14rpx; animation-delay: 0.5s; }
.bar-4 { height: 22rpx; animation-delay: 0.2s; }
.bar-5 { height: 12rpx; animation-delay: 0.4s; }

@keyframes barWave {
  0% { height: 6rpx; }
  100% { height: 24rpx; }
}

/* 状态徽标 */
.dh-badge {
  position: absolute;
  bottom: 24rpx;
  right: 6rpx;
  background: #ffffff;
  border-radius: 50%;
  padding: 4rpx;
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.12);
  z-index: 4;
}

.dh-badge-inner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  background: #f8fafc;
  color: var(--primary-color, #9d174d);
}

/* 状态提示文字 */
.dh-status-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  max-width: 360rpx;
  line-height: 1.4;
}
