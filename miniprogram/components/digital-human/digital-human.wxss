/** digital-human.wxss **/

.dh-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}

/* 尺寸预设 */
.dh-mini .dh-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.dh-normal .dh-avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.dh-large .dh-avatar-wrap {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
}

/* 风格色系变量 */
.dh-zen_red_gold {
  --primary-color: #c41d7f;
  --glow-color: rgba(196, 29, 127, 0.25);
  --ring-color: rgba(233, 30, 99, 0.45);
}

.dh-celadon_elegance {
  --primary-color: #2e7d5b;
  --glow-color: rgba(46, 125, 91, 0.25);
  --ring-color: rgba(76, 175, 158, 0.45);
}

.dh-tang_splendor {
  --primary-color: #b8860b;
  --glow-color: rgba(184, 134, 11, 0.25);
  --ring-color: rgba(212, 168, 83, 0.45);
}

.dh-ink_wash {
  --primary-color: #455a7b;
  --glow-color: rgba(69, 90, 123, 0.25);
  --ring-color: rgba(107, 141, 181, 0.45);
}

/* 肖像外框与呼吸微动效 */
.dh-avatar-wrap {
  position: relative;
  overflow: hidden;
  border: 4rpx solid var(--primary-color, #c41d7f);
  box-shadow: 0 8rpx 24rpx var(--glow-color, rgba(196, 29, 127, 0.25));
  background: #ffffff;
  z-index: 2;
  transition: transform 0.3s ease;
  animation: dhBreath 4s ease-in-out infinite;
}

@keyframes dhBreath {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.03);
  }
}

.dh-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 氛围光环 */
.dh-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 130%;
  height: 130%;
  border-radius: 50%;
  background: radial-gradient(circle, var(--glow-color, rgba(196, 29, 127, 0.3)) 0%, transparent 70%);
  z-index: 1;
  pointer-events: none;
}

/* 播报中光环脉冲 */
.dh-speaking .dh-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 115%;
  height: 115%;
  border-radius: 50%;
  border: 4rpx solid var(--ring-color, rgba(233, 30, 99, 0.5));
  z-index: 1;
  animation: ringPulse 1.8s infinite;
  pointer-events: none;
}

@keyframes ringPulse {
  0% {
    transform: translate(-50%, -50%) scale(0.95);
    opacity: 0.8;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.35);
    opacity: 0;
  }
}

/* 播报音浪跳动柱条 */
.dh-sound-bars {
  position: absolute;
  top: -24rpx;
  display: flex;
  gap: 6rpx;
  align-items: flex-end;
  height: 24rpx;
  z-index: 3;
}

.dh-bar {
  width: 6rpx;
  background: var(--primary-color, #c41d7f);
  border-radius: 4rpx;
  animation: barWave 1s ease-in-out infinite alternate;
}

.bar-1 { height: 12rpx; animation-delay: 0.1s; }
.bar-2 { height: 22rpx; animation-delay: 0.3s; }
.bar-3 { height: 16rpx; animation-delay: 0.5s; }
.bar-4 { height: 24rpx; animation-delay: 0.2s; }
.bar-5 { height: 14rpx; animation-delay: 0.4s; }

@keyframes barWave {
  0% { height: 8rpx; }
  100% { height: 26rpx; }
}

/* 状态徽标 */
.dh-badge {
  position: absolute;
  bottom: 30rpx;
  right: 10rpx;
  background: #ffffff;
  border-radius: 50%;
  padding: 6rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
  font-size: 24rpx;
  z-index: 4;
}

/* 状态提示文字 */
.dh-status-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #4b5563);
  text-align: center;
  max-width: 360rpx;
  line-height: 1.4;
}
