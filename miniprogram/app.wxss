/** app.wxss — 灵小禅微信小程序全局样式表 **/

page {
  --primary: #c41d7f;
  --primary-gradient: linear-gradient(135deg, #c41d7f 0%, #e91e63 100%);
  --primary-light: #fdf2f8;
  --primary-border: #fbcfe8;
  --accent: #e91e63;
  --gold: #b8860b;
  --gold-light: #fefce8;
  --celadon: #2e7d5b;
  --celadon-light: #f0fdf4;
  --ink: #455a7b;
  --text-primary: #1f2937;
  --text-secondary: #4b5563;
  --text-muted: #9ca3af;
  --bg-page: #f8f9fa;
  --bg-card: #ffffff;
  --border-color: #f0f0f0;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(196, 29, 127, 0.15);

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* 全局容器 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 禅意卡片 */
.zen-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.zen-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 渐变主按钮 */
.btn-primary {
  background: var(--primary-gradient);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--shadow-lg);
  transition: opacity 0.2s;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  background: #e5e7eb !important;
  color: #9ca3af !important;
  box-shadow: none !important;
}

/* 次要空心按钮 */
.btn-secondary {
  background: #ffffff;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
  padding: 16rpx 32rpx;
  border: 2rpx solid var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-secondary:active {
  background: var(--primary-light);
}

/* 禅意标签 */
.zen-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: var(--primary-light);
  color: var(--primary);
  border: 1rpx solid var(--primary-border);
}

.zen-tag-gold {
  background: var(--gold-light);
  color: var(--gold);
  border-color: #fef08a;
}

.zen-tag-celadon {
  background: var(--celadon-light);
  color: var(--celadon);
  border-color: #bbf7d0;
}

.zen-tag-gray {
  background: #f3f4f6;
  color: var(--text-secondary);
  border-color: #e5e7eb;
}

/* 状态提示框 */
.alert-box {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.alert-info {
  background: #eff6ff;
  color: #1d4ed8;
  border: 1rpx solid #bfdbfe;
}

.alert-warning {
  background: #fffbeb;
  color: #b45309;
  border: 1rpx solid #fde68a;
}

.alert-error {
  background: #fef2f2;
  color: #b91c1c;
  border: 1rpx solid #fecaca;
}

.alert-success {
  background: #f0fdf4;
  color: #15803d;
  border: 1rpx solid #bbf7d0;
}

/* 辅助排版 */
.text-center { text-align: center; }
.text-muted { color: var(--text-muted); }
.text-sm { font-size: 24rpx; }
.text-xs { font-size: 20rpx; }
.font-bold { font-weight: 600; }
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-1 { flex: 1; }
.gap-8 { gap: 16rpx; }
.gap-12 { gap: 24rpx; }
