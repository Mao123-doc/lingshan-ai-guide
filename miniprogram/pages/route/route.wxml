<!-- pages/route/route.wxml -->
<view class="container route-container">
  <!-- 离线或警告提示 -->
  <view wx:if="{{isOfflineView}}" class="alert-box alert-warning">
    <text class="alert-symbol">🍃</text>
    <text class="alert-content">正在使用本地离线导览路网。离线模式提供基础游览动线与无障碍通道推荐；如需实时演出时刻与智能定制，请连接网络。</text>
  </view>
  <view wx:if="{{errorMessage}}" class="alert-box alert-error">
    <text class="alert-symbol">✕</text>
    <text class="alert-content">{{errorMessage}}</text>
  </view>

  <!-- 顶部规划方式 Tab 切换 -->
  <view class="route-tabs">
    <view
      class="tab-item {{activeTab === 'natural' ? 'tab-active' : ''}}"
      bindtap="switchTab"
      data-tab="natural"
    >
      <text>一句话智能定制</text>
    </view>
    <view
      class="tab-item {{activeTab === 'structured' ? 'tab-active' : ''}}"
      bindtap="switchTab"
      data-tab="structured"
    >
      <text>详细偏好定制</text>
    </view>
  </view>

  <!-- 选项卡 1：自然语言一句话智能定制 -->
  <view wx:if="{{activeTab === 'natural'}}" class="zen-card">
    <view class="card-headline">
      <view class="headline-title-wrap">
        <text class="headline-seal">定</text>
        <text class="headline-title">一句话说出游玩心愿</text>
      </view>
    </view>
    <view class="card-tip">
      告诉小禅您的游玩时间、随行家人以及想看的演出（如九龙灌浴、吉祥颂），即刻为您生成专属游览路线。
    </view>
    <textarea
      class="query-textarea"
      value="{{sceneQuery}}"
      bindinput="onQueryInput"
      placeholder="例如：我带腿脚不方便的妈妈，现在在景区入口，只有三小时，还想看两点的《吉祥颂》，应该怎么走？"
      maxlength="300"
    />
    <button
      class="btn-primary"
      style="margin-top: 24rpx;"
      bindtap="handleNaturalPlan"
      loading="{{isLoading}}"
      disabled="{{isLoading || !sceneQuery}}"
    >
      生成专属游览路线
    </button>
  </view>

  <!-- 选项卡 2：结构化详细偏好表单定制 -->
  <view wx:if="{{activeTab === 'structured'}}" class="zen-card">
    <view class="card-headline">
      <view class="headline-title-wrap">
        <text class="headline-seal">选</text>
        <text class="headline-title">游览偏好详细定制</text>
      </view>
    </view>

    <!-- 起点与时间 -->
    <view class="form-row">
      <view class="form-col">
        <text class="form-label">出发地点</text>
        <picker
          mode="selector"
          range="{{spots}}"
          range-key="name"
          bindchange="onStartSpotChange"
        >
          <view class="picker-value">
            {{spots[0] ? (startSpotId === 'south_gate' ? '景区南门入口' : startSpotId) : '选择起点'}} ›
          </view>
        </picker>
      </view>
      <view class="form-col">
        <text class="form-label">出发时间</text>
        <picker mode="time" value="{{currentTimeStr}}" bindchange="onTimeChange">
          <view class="picker-value font-numeric">{{currentTimeStr}} ›</view>
        </picker>
      </view>
    </view>

    <!-- 游览时长 -->
    <view class="form-section">
      <text class="form-label">预计游玩时间</text>
      <view class="tag-selector">
        <view
          wx:for="{{[2, 3, 4, 5, 6]}}"
          wx:key="*this"
          class="select-tag {{durationHours === item ? 'selected' : ''}}"
          bindtap="onDurationChange"
          data-hours="{{item}}"
        >
          <text class="font-numeric">{{item}}</text> 小时
        </view>
      </view>
    </view>

    <!-- 行动能力与无障碍通道 -->
    <view class="form-section">
      <text class="form-label">出行便利与无障碍通道</text>
      <view class="mobility-grid">
        <view
          class="mobility-card {{mobility === 'normal' ? 'mobility-selected' : ''}}"
          bindtap="onMobilityChange"
          data-val="normal"
        >
          <view class="mob-title">轻松步行</view>
          <view class="mob-desc">常规步道与登山捷径</view>
        </view>
        <view
          class="mobility-card {{mobility === 'limited' ? 'mobility-selected' : ''}}"
          bindtap="onMobilityChange"
          data-val="limited"
        >
          <view class="mob-title">舒适漫游</view>
          <view class="mob-desc">长辈同行，多平路休憩</view>
        </view>
        <view
          class="mobility-card {{mobility === 'wheelchair' ? 'mobility-selected' : ''}}"
          bindtap="onMobilityChange"
          data-val="wheelchair"
        >
          <view class="mob-title">全线无障碍</view>
          <view class="mob-desc">轮椅/童车，全坡道通行</view>
        </view>
      </view>
    </view>

    <!-- 同行类型 -->
    <view class="form-section">
      <text class="form-label">同行人群</text>
      <view class="tag-selector">
        <view
          wx:for="{{['带长辈', '亲子家庭', '情侣携手', '好友同游', '独自一人']}}"
          wx:key="*this"
          class="select-tag {{travelType === item ? 'selected' : ''}}"
          bindtap="onTravelTypeChange"
          data-val="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <!-- 游览偏好 -->
    <view class="form-section">
      <text class="form-label">游览心愿（可多选）</text>
      <view class="interests-grid">
        <view
          wx:for="{{interestsList}}"
          wx:key="key"
          class="interest-card {{selectedInterests.indexOf(item.key) >= 0 ? 'interest-selected' : ''}}"
          bindtap="toggleInterest"
          data-key="{{item.key}}"
        >
          <text class="int-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <button
      class="btn-primary"
      style="margin-top: 24rpx;"
      bindtap="handleStructuredPlan"
      loading="{{isLoading}}"
    >
      生成个性化路线
    </button>
  </view>

  <!-- 路线规划结果展区 -->
  <block wx:if="{{routePlan}}">
    <!-- 规划结论卡片 -->
    <view class="zen-card outcome-card">
      <view class="outcome-header">
        <text class="zen-tag {{routeOutcome === 'feasible' ? 'zen-tag-celadon' : (routeOutcome === 'feasible_with_rejected_preferences' ? 'zen-tag-gold' : 'zen-tag')}}">
          {{routeOutcomeLabel}}
        </text>
        <text class="outcome-total font-numeric">预计用时 {{routePlan.route.totalMinutes || 0}} 分钟</text>
      </view>

      <view class="outcome-stats">
        <view class="stat-item">
          <text class="stat-num font-numeric">{{routePlan.route.walkingMinutes || 0}}</text>
          <text class="stat-unit">分钟步行</text>
        </view>
        <view class="stat-item">
          <text class="stat-num font-numeric">{{routePlan.route.visitingMinutes || 0}}</text>
          <text class="stat-unit">分钟游览</text>
        </view>
        <view class="stat-item" wx:if="{{routePlan.route.waitingMinutes}}">
          <text class="stat-num font-numeric">{{routePlan.route.waitingMinutes}}</text>
          <text class="stat-unit">分钟候场</text>
        </view>
        <view class="stat-item">
          <text class="stat-num font-numeric">{{routeSteps.length}}</text>
          <text class="stat-unit">处代表景点</text>
        </view>
      </view>

      <!-- 信息缺失澄清提示 -->
      <view wx:if="{{clarificationPrompt}}" class="alert-box alert-warning">
        <view class="clarify-wrap">
          <text class="clarify-text">{{clarificationPrompt}}</text>
          <view class="clarify-input-row">
            <input
              class="clarify-input"
              value="{{clarificationInput}}"
              bindinput="onClarificationInput"
              placeholder="例如：我们上午10:00入园"
            />
            <button class="mini-btn-accent" size="mini" bindtap="submitClarification">
              补充并更新
            </button>
          </view>
        </view>
      </view>

      <!-- 偏好调整说明 -->
      <view wx:if="{{rejectedList.length > 0}}" class="alert-box alert-info">
        <view>
          <view style="font-weight: 700; margin-bottom: 6rpx;">偏好行程调整说明：</view>
          <view wx:for="{{rejectedList}}" wx:key="index">
            · {{item.item}}：{{item.reason}}
          </view>
        </view>
      </view>
    </view>

    <!-- 游园打卡与智能调优卡片 -->
    <view class="zen-card progress-card">
      <view class="card-headline">
        <view class="headline-title-wrap">
          <text class="headline-seal">迹</text>
          <text class="headline-title">游园打卡与智能调优</text>
        </view>
      </view>
      <view class="card-tip">
        游览时可随手打卡记录足迹。若您在某一景点停留更久，小禅会自动为您调优后续行程，确保顺利出园。
      </view>

      <view class="progress-switch-row">
        <text class="switch-label">游玩超时自动优化后续路线</text>
        <switch checked="{{autoCorrect}}" bindchange="onAutoCorrectToggle" color="#8f202e" />
      </view>

      <view wx:if="{{progressNotice}}" class="alert-box alert-info">
        <text>{{progressNotice}}</text>
      </view>

      <view class="progress-actions">
        <button class="btn-secondary" size="mini" bindtap="replanFromProgress">
          按当前进度优化路线
        </button>
      </view>
    </view>

    <!-- 建议游览动线时间轴 -->
    <view class="timeline-wrap">
      <view class="timeline-title-row">
        <text class="timeline-seal">线</text>
        <text class="timeline-title">今日建议游览动线</text>
      </view>

      <view class="timeline-list">
        <view
          wx:for="{{routeSteps}}"
          wx:key="stepIndex"
          class="step-item {{completedSpotIds.indexOf(item.spotId) >= 0 ? 'step-completed' : ''}} {{item.isReturn ? 'step-return' : ''}}"
        >
          <!-- 左侧节点标识与连线 -->
          <view class="step-axis">
            <view class="step-node-badge">
              <text class="font-numeric">{{item.isReturn ? '出' : item.stepIndex}}</text>
            </view>
            <view wx:if="{{index < routeSteps.length - 1}}" class="step-line"></view>
          </view>

          <!-- 右侧卡片内容 -->
          <view class="step-card-body">
            <view class="step-header">
              <view class="step-name">
                {{item.isReturn ? '出口返程：' : ''}}{{item.spotName}}
                <text wx:if="{{item.performanceName}}" class="tag-performance">
                  {{item.performanceName}}
                </text>
              </view>
              <view class="step-times font-numeric">
                {{item.start}} - {{item.end}}
              </view>
            </view>

            <view class="step-metrics font-numeric">
              <text>步行 {{item.walkMinutes}} 分钟 ({{item.distanceMeters || 0}}米)</text>
              <text> · 停留 {{item.visitMinutes}} 分钟</text>
              <text wx:if="{{item.waitingMinutes}}"> · 候场 {{item.waitingMinutes}} 分钟</text>
            </view>

            <view class="step-accessibility">
              <text>{{item.accessibleDesc}}</text>
            </view>

            <view class="step-actions">
              <button
                class="step-action-btn btn-nav"
                size="mini"
                bindtap="openStepNav"
                data-step="{{item}}"
              >
                实景导航
              </button>
              <button
                class="step-action-btn"
                size="mini"
                bindtap="askStepDetail"
                data-name="{{item.spotName}}"
              >
                讲解
              </button>
              <button
                wx:if="{{!item.isReturn && completedSpotIds.indexOf(item.spotId) < 0}}"
                class="step-action-btn btn-check"
                size="mini"
                bindtap="confirmProgressStep"
                data-id="{{item.spotId}}"
              >
                打卡
              </button>
              <text wx:elif="{{!item.isReturn}}" class="check-done-tag">
                已打卡
              </text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 离线备用路线按钮 -->
  <view class="offline-bar">
    <button class="btn-secondary" bindtap="handleOfflinePlan">
      离线备用路线（无网络时可用）
    </button>
  </view>
</view>
