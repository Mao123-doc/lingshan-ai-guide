/** pages/route/route.wxss **/

.route-container {
  padding-bottom: 80rpx;
}

/* 规划选项卡切换 */
.route-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 16rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: var(--primary-gradient);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(196, 29, 127, 0.2);
}

.card-tip {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.query-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 表单行与列 */
.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.form-col {
  flex: 1;
}

.form-section {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.picker-value {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #374151;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 标签式单选/多选 */
.tag-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.select-tag {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.select-tag.selected {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* 兴趣网格 */
.interests-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.interest-card {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 18rpx 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.interest-card.interest-selected {
  background: var(--primary-light);
  border-color: var(--primary);
}

.int-icon {
  font-size: 32rpx;
}

.int-label {
  font-size: 22rpx;
  color: var(--text-primary);
}

/* 结果卡片 */
.outcome-card {
  border-top: 6rpx solid var(--primary);
}

.outcome-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.outcome-total {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.outcome-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-unit {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 澄清追问输入 */
.clarify-wrap {
  width: 100%;
}

.clarify-text {
  font-size: 24rpx;
  margin-bottom: 12rpx;
  display: block;
}

.clarify-input-row {
  display: flex;
  gap: 12rpx;
}

.clarify-input {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
}

/* 进度纠偏卡片 */
.progress-card {
  background: #fcfdfe;
}

.progress-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.switch-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.progress-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

/* 时间轴 */
.timeline-wrap {
  margin-top: 32rpx;
}

.timeline-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.step-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid #f0f0f0;
  display: flex;
  gap: 20rpx;
}

.step-completed {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.step-return {
  border-style: dashed;
  border-color: #d1d5db;
}

.step-badge {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.step-completed .step-badge {
  background: #167858;
}

.step-main {
  flex: 1;
}

.step-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.step-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag-performance {
  font-size: 20rpx;
  background: #fdf2f8;
  color: var(--primary);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.step-times {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  background: #fdf2f8;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.step-metrics {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

.step-accessibility {
  font-size: 22rpx;
  color: #059669;
  margin-bottom: 16rpx;
}

.step-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.mini-btn {
  background: #f3f4f6 !important;
  color: #374151 !important;
  font-size: 22rpx !important;
  padding: 8rpx 16rpx !important;
  border-radius: 14rpx !important;
  margin: 0 !important;
}

.mini-btn-accent {
  background: var(--primary-light) !important;
  color: var(--primary) !important;
  font-size: 22rpx !important;
  padding: 8rpx 16rpx !important;
  border-radius: 14rpx !important;
  margin: 0 !important;
}

.check-done-tag {
  font-size: 22rpx;
  color: #059669;
  font-weight: 600;
  margin-left: 8rpx;
}

/* 离线应急按钮区 */
.offline-bar {
  margin-top: 40rpx;
  text-align: center;
}
