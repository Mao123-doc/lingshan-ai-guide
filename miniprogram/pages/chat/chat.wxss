/** pages/chat/chat.wxss **/

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f9fa;
  overflow: hidden;
}

/* 顶部状态与数字人栏 */
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  z-index: 10;
}

.header-companion {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.companion-info {
  display: flex;
  flex-direction: column;
}

.companion-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.companion-status {
  font-size: 20rpx;
  color: var(--primary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mode-tag {
  background: var(--primary-light);
  color: var(--primary);
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--primary-border);
}

.reset-btn {
  background: #f3f4f6;
  color: #4b5563;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 消息滚动列表 */
.messages-scroll {
  flex: 1;
  overflow-y: scroll;
}

.messages-inner {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.msg-row {
  display: flex;
  width: 100%;
}

.msg-user {
  justify-content: flex-end;
}

.msg-assistant {
  justify-content: flex-start;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid var(--primary);
  flex-shrink: 0;
}

.avatar-mini-img {
  width: 100%;
  height: 100%;
}

/* 气泡样式 */
.msg-bubble {
  max-width: 80%;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.user-bubble {
  background: var(--primary-gradient);
  color: #ffffff;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(196, 29, 127, 0.2);
}

.assistant-bubble {
  background: #ffffff;
  color: var(--text-primary);
  border-top-left-radius: 6rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.msg-text {
  white-space: pre-wrap;
}

/* 打字机光标与提示 */
.typing-cursor {
  display: inline-block;
  font-weight: 700;
  color: var(--primary);
  animation: blink 0.8s infinite;
  margin-left: 4rpx;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.streaming-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 回答操作栏与依据 */
.answer-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.answer-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-time {
  font-size: 20rpx;
  color: #9ca3af;
}

.btn-group {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.action-btn {
  background: #f9fafb !important;
  color: var(--text-secondary) !important;
  border: 1rpx solid #e5e7eb !important;
  font-size: 22rpx !important;
  padding: 6rpx 16rpx !important;
  border-radius: 20rpx !important;
  line-height: 1.4 !important;
  margin: 0 !important;
}

.action-btn:active {
  background: #f3f4f6 !important;
}

.action-btn-active {
  background: var(--primary-light) !important;
  color: var(--primary) !important;
  border-color: var(--primary) !important;
  font-weight: 600;
}

.rated-text {
  font-size: 22rpx;
  color: #167858;
}

/* 底部快捷工具栏 */
.tools-bar {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.tool-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
}

.tool-btn:active {
  background: #f3f4f6;
}

.tool-btn.recording {
  background: #fef2f2;
  border-color: #f87171;
  color: #dc2626;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.tool-icon {
  font-size: 26rpx;
}

.tool-label {
  font-size: 22rpx;
  color: #4b5563;
}

/* 底部输入框 */
.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
}

.chat-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 180rpx;
  background: #f3f4f6;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.btn-send {
  background: var(--primary-gradient);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  height: 72rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: none;
}

.btn-send.disabled {
  background: #e5e7eb;
  color: #9ca3af;
}

/* 弹窗通用 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.modal-card {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: var(--shadow-lg);
}

.modal-large {
  max-width: 680rpx;
}

.modal-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 4rpx 12rpx;
}

.modal-notice {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 20rpx;
  line-height: 1.4;
  background: #f9fafb;
  padding: 12rpx;
  border-radius: 12rpx;
}

/* 评分星星 */
.rating-stars {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 28rpx 0;
}

.star {
  font-size: 56rpx;
  color: #d1d5db;
  cursor: pointer;
}

.star-filled {
  color: #f59e0b;
}

.feedback-input {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 28rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-actions button {
  flex: 1;
}

/* 附近列表 */
.nearby-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.nearby-left {
  flex: 1;
}

.nearby-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.nearby-sub {
  font-size: 22rpx;
  color: #6b7280;
}

.tag-warn {
  color: #d97706;
  margin-left: 8rpx;
}

.nearby-right {
  display: flex;
  gap: 10rpx;
}

.mini-btn {
  background: #f3f4f6 !important;
  color: #374151 !important;
  font-size: 22rpx !important;
  padding: 6rpx 14rpx !important;
  border-radius: 12rpx !important;
  margin: 0 !important;
}

.mini-btn-accent {
  background: var(--primary-light) !important;
  color: var(--primary) !important;
  font-size: 22rpx !important;
  padding: 6rpx 14rpx !important;
  border-radius: 12rpx !important;
  margin: 0 !important;
}
