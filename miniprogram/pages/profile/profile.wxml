<!-- pages/profile/profile.wxml -->
<view class="container profile-container">
  <!-- 导游形象与服饰定制 -->
  <view class="zen-card">
    <view class="zen-card-title">
      <text class="title-accent">◆</text>
      <text>随身导游形象与服饰</text>
    </view>
    <view class="dh-preview-wrap">
      <digital-human
        stylePreset="{{currentStyle}}"
        emotion="greet"
        size="large"
        showStatusText="{{true}}"
      />
    </view>

    <view class="styles-grid">
      <view
        wx:for="{{styles}}"
        wx:key="key"
        class="style-item {{currentStyle === item.key ? 'style-active' : ''}}"
        bindtap="onStyleSelect"
        data-key="{{item.key}}"
      >
        <view class="style-color-dot" style="background: {{item.color}};"></view>
        <view class="style-name">{{item.name}}</view>
        <view class="style-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 离线应急数据缓存管理 -->
  <view class="zen-card">
    <view class="zen-card-title">
      <text class="title-accent">◆</text>
      <text>离线导览数据包</text>
    </view>
    <view class="cache-info-box">
      <view class="cache-row">
        <text class="cache-label">导览包状态：</text>
        <text class="cache-val">{{cachedGraphInfo ? '已就绪（含23处胜境景观与平缓步道）' : '未下载'}}</text>
      </view>
      <view class="cache-row font-numeric" wx:if="{{cachedGraphInfo}}">
        <text class="cache-label">更新时间：</text>
        <text class="cache-val">{{cachedGraphInfo.cachedAt}}</text>
      </view>
      <view class="cache-row font-numeric">
        <text class="cache-label">离线景点库：</text>
        <text class="cache-val">{{cachedSpotsCount}} 处景点详述</text>
      </view>
    </view>

    <view class="cache-btn-row">
      <button class="btn-secondary" size="mini" bindtap="clearCache">
        清空缓存
      </button>
      <button class="btn-primary" size="mini" bindtap="cacheAllData">
        更新离线导览包
      </button>
    </view>
  </view>

  <!-- 我的收藏景点 -->
  <view wx:if="{{favoriteSpots.length > 0}}" class="zen-card">
    <view class="zen-card-title">
      <text class="title-accent">◆</text>
      <text>我的收藏景点</text>
    </view>
    <view class="fav-list">
      <view
        wx:for="{{favoriteSpots}}"
        wx:key="id"
        class="fav-item"
        bindtap="goToSpotDetail"
        data-id="{{item.id}}"
      >
        <view class="fav-item-left">
          <view class="fav-item-name">{{item.name}}</view>
          <view class="fav-item-sub font-numeric">建议游览 {{item.visit_minutes}} 分钟</view>
        </view>
        <view class="fav-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 导览网络设置（高级选项） -->
  <view class="zen-card">
    <view class="zen-card-title">
      <text class="title-accent">◆</text>
      <text>导览服务连接设置（高级）</text>
    </view>
    <view class="card-tip">
      小程序默认直连灵山胜境官方智慧导览服务。如您在局域网内进行调试或演示，可在下方自定义服务地址。
    </view>
    <input
      class="api-input font-numeric"
      value="{{apiBaseUrl}}"
      bindinput="onApiUrlInput"
      placeholder="请输入服务 API 基础地址"
    />
    <view class="api-btn-row">
      <button class="btn-secondary" size="mini" bindtap="resetDefaultApiUrl">
        恢复默认
      </button>
      <button class="btn-primary" size="mini" bindtap="saveApiUrl">
        保存并测试
      </button>
    </view>
    <view class="ping-status-row">
      <text class="ping-label">服务状态：</text>
      <text class="ping-val">{{serverPingStatus}}</text>
    </view>
  </view>

  <!-- 关于与版本信息 -->
  <view class="footer-note">
    <view class="footer-badge">灵山胜境 · 灵小禅智慧文旅导览</view>
    <view class="footer-sub">无锡灵山文化旅游集团 版权所有</view>
  </view>
</view>
