<!-- pages/profile/profile.wxml -->
<view class="container profile-container">
  <!-- 数字人形象与风格定制 -->
  <view class="zen-card">
    <view class="zen-card-title">
      <text>🌸 灵小禅形象风格定制</text>
    </view>
    <view class="dh-preview-wrap">
      <digital-human
        stylePreset="{{currentStyle}}"
        emotion="greet"
        size="large"
        showStatusText="{{true}}"
      />
    </view>

    <view class="styles-grid">
      <view
        wx:for="{{styles}}"
        wx:key="key"
        class="style-item {{currentStyle === item.key ? 'style-active' : ''}}"
        bindtap="onStyleSelect"
        data-key="{{item.key}}"
      >
        <view class="style-color-dot" style="background: {{item.color}};"></view>
        <view class="style-name">{{item.name}}</view>
        <view class="style-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 后端服务地址与连接测试（支持本地与真机调试） -->
  <view class="zen-card">
    <view class="zen-card-title">
      <text>🔗 后端服务地址配置</text>
    </view>
    <view class="card-tip">
      本地微信开发者工具默认为 http://127.0.0.1:8010/api/v1。手机真机预览时，请输入电脑的局域网 IP（如 http://192.168.1.100:8010/api/v1）。
    </view>
    <input
      class="api-input"
      value="{{apiBaseUrl}}"
      bindinput="onApiUrlInput"
      placeholder="请输入后端 API Base URL"
    />
    <view class="api-btn-row">
      <button class="btn-secondary" size="mini" bindtap="resetDefaultApiUrl">
        恢复默认
      </button>
      <button class="btn-primary" size="mini" bindtap="saveApiUrl">
        保存并测试
      </button>
    </view>
    <view class="ping-status-row">
      <text class="ping-label">连接状态：</text>
      <text class="ping-val">{{serverPingStatus}}</text>
    </view>
  </view>

  <!-- 离线应急数据缓存管理 -->
  <view class="zen-card">
    <view class="zen-card-title">
      <text>📴 离线路网与缓存管理</text>
    </view>
    <view class="cache-info-box">
      <view class="cache-row">
        <text class="cache-label">缓存状态：</text>
        <text class="cache-val">{{cachedGraphInfo ? '已就绪（含23景点30拓扑道路）' : '未缓存'}}</text>
      </view>
      <view class="cache-row" wx:if="{{cachedGraphInfo}}">
        <text class="cache-label">缓存时间：</text>
        <text class="cache-val">{{cachedGraphInfo.cachedAt}}</text>
      </view>
      <view class="cache-row">
        <text class="cache-label">离线景点库：</text>
        <text class="cache-val">{{cachedSpotsCount}} 个景点数据</text>
      </view>
    </view>

    <view class="cache-btn-row">
      <button class="btn-secondary" size="mini" bindtap="clearCache">
        清空缓存
      </button>
      <button class="btn-primary" size="mini" bindtap="cacheAllData">
        立即更新全景区路网
      </button>
    </view>
  </view>

  <!-- 我的收藏景点 -->
  <view wx:if="{{favoriteSpots.length > 0}}" class="zen-card">
    <view class="zen-card-title">
      <text>❤️ 我的常用收藏</text>
    </view>
    <view class="fav-list">
      <view
        wx:for="{{favoriteSpots}}"
        wx:key="id"
        class="fav-item"
        bindtap="goToSpotDetail"
        data-id="{{item.id}}"
      >
        <text class="fav-name">{{item.name}}</text>
        <text class="fav-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 系统权威架构与参赛说明 -->
  <view class="zen-card tech-card">
    <view class="zen-card-title">
      <text>🏛️ 灵小禅技术架构与透明度声明</text>
    </view>
    <view class="tech-row">
      <text class="tech-key">参赛赛道：</text>
      <text class="tech-val">第八届全球校园人工智能算法精英大赛（AIC）· 算法创新赛</text>
    </view>
    <view class="tech-row">
      <text class="tech-key">核心范式：</text>
      <text class="tech-val">双引擎软硬解耦（语义理解大模型 + 物理时空运筹引擎）</text>
    </view>
    <view class="tech-row">
      <text class="tech-key">检索机制：</text>
      <text class="tech-val">Promise.all 三路并行检索 + RRF 融合 (k=60) + 官方指南置顶</text>
    </view>
    <view class="tech-row">
      <text class="tech-key">路网基准：</text>
      <text class="tech-val">23 核心实体景点 · 30 拓扑连接边数字孪生拓扑</text>
    </view>
    <view class="tech-row">
      <text class="tech-key">真实性边界：</text>
      <text class="tech-val">GPS与附近距离为坐标直线几何距离；离线规划不含实时演出；动态模型为测试示例，定制汉服为高保真静态立绘。</text>
    </view>
  </view>
</view>
