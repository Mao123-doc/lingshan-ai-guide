/** pages/home/home.wxss **/

.home-container {
  padding-top: 16rpx;
}

/* 顶部 Hero 展区 */
.hero-card {
  position: relative;
  background: linear-gradient(135deg, #2b131e 0%, #4a1936 50%, #c41d7f 100%);
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(196, 29, 127, 0.22);
}

.hero-bg-accent {
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(233, 30, 99, 0.35) 0%, transparent 70%);
  pointer-events: none;
}

.hero-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  position: relative;
  z-index: 2;
}

.hero-text-wrap {
  flex: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8px);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-bottom: 16rpx;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.dot-online {
  background: #34d399;
  box-shadow: 0 0 8rpx #34d399;
}

.dot-offline {
  background: #fbbf24;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #fbcfe8;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.hero-avatar-wrap {
  width: 180rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 核心模块卡片 */
.modules-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.module-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.module-card:active {
  transform: translateY(2rpx);
}

.card-qa {
  border-color: #fbcfe8;
  background: linear-gradient(180deg, #ffffff 0%, #fdf2f8 100%);
}

.card-route {
  border-color: #d1fae5;
  background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);
}

.module-icon-wrap {
  font-size: 40rpx;
}

.module-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.module-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.module-action {
  align-self: flex-end;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.card-route .module-action {
  color: var(--celadon);
}

/* 次级能力入口行 */
.sub-modules-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.sub-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  box-shadow: var(--shadow-sm);
  text-align: center;
  border: 1rpx solid #f0f0f0;
}

.sub-card:active {
  background: #fdf2f8;
}

.sub-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.sub-desc {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 热门问题 */
.questions-card {
  padding-bottom: 12rpx;
}

.questions-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.question-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f9fafb;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #374151;
}

.question-item:active {
  background: #fdf2f8;
  color: var(--primary);
}

.q-icon {
  font-size: 26rpx;
}

.q-text {
  flex: 1;
}

.q-arrow {
  color: #9ca3af;
  font-size: 32rpx;
  line-height: 1;
}

/* 底部声明 */
.footer-note {
  text-align: center;
  padding: 30rpx 20rpx;
  font-size: 22rpx;
  color: #9ca3af;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.footer-sub {
  font-size: 20rpx;
  color: #d1d5db;
}
