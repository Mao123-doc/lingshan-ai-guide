/** pages/home/home.wxss **/

.home-container {
  padding-top: 16rpx;
}

/* 顶部 Hero 展区 */
.hero-card {
  position: relative;
  background: linear-gradient(140deg, #1e1b4b 0%, #311028 35%, #701a45 75%, #9d174d 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  color: #ffffff;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx -6rpx rgba(112, 26, 69, 0.35), 0 4rpx 12rpx -2rpx rgba(15, 23, 42, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.hero-bg-pattern {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(244, 114, 182, 0.25) 0%, rgba(217, 119, 6, 0.15) 50%, transparent 75%);
  pointer-events: none;
}

.hero-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  position: relative;
  z-index: 2;
}

.hero-text-wrap {
  flex: 1;
}

.hero-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 0.8rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.status-online {
  color: #a7f3d0;
}

.status-offline {
  color: #fde68a;
}

.status-pulse-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 8rpx currentColor;
}

.hero-tagline {
  font-size: 26rpx;
  font-weight: 600;
  color: #fbcfe8;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.hero-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}

.hero-avatar-wrap {
  width: 180rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 核心模块卡片 */
.modules-grid {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-bottom: 26rpx;
}

.module-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  border: 1.5rpx solid rgba(226, 232, 240, 0.8);
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  position: relative;
  overflow: hidden;
}

.module-card:active {
  transform: translateY(2rpx);
  box-shadow: var(--shadow-md);
}

.card-qa {
  border-color: #fecdd3;
  background: linear-gradient(180deg, #ffffff 0%, #fff1f2 100%);
}

.card-route {
  border-color: #99f6e4;
  background: linear-gradient(180deg, #ffffff 0%, #f0fdfa 100%);
}

.module-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.module-icon-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-qa {
  background: #ffe4e6;
  color: var(--primary);
}

.badge-route {
  background: #ccfbf1;
  color: var(--celadon);
}

.module-action-pill {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(157, 23, 77, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  transition: background 0.15s ease;
}

.pill-route {
  color: var(--celadon);
  background: rgba(15, 118, 110, 0.08);
}

.module-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.module-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.module-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  padding-top: 6rpx;
}

.sub-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(157, 23, 77, 0.06);
  color: var(--primary);
}

.sub-tag-teal {
  background: rgba(15, 118, 110, 0.06);
  color: var(--celadon);
}

/* 辅助功能行 */
.sub-modules-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.sub-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx 18rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12rpx;
  transition: all 0.15s ease;
}

.sub-card:active {
  transform: scale(0.97);
  background: #f8fafc;
}

.sub-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
  color: var(--ink-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 2rpx;
}

.sub-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  line-height: 1.3;
}

/* 热门问题卡片 */
.questions-card {
  padding: 28rpx;
}

.title-accent {
  color: var(--primary);
  font-size: 22rpx;
}

.questions-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 16rpx;
}

.question-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.6);
  transition: all 0.15s ease;
}

.question-item:active {
  background: var(--primary-light);
  border-color: var(--primary-border);
}

.q-marker {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
}

.q-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  line-height: 1.4;
}

.q-arrow {
  color: var(--ink-muted);
  display: flex;
  align-items: center;
}

/* 底部提示 */
.footer-note {
  text-align: center;
  padding: 32rpx 0 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}

.footer-badge {
  font-size: 22rpx;
  color: var(--ink-light);
  font-weight: 600;
  background: #f1f5f9;
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
}

.footer-sub {
  font-size: 20rpx;
  color: var(--text-muted);
}
