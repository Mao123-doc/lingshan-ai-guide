/** pages/spots/spots.wxss — 灵小禅移动端景点列表样式 **/

.spots-container {
  padding-top: 16rpx;
}

/* 顶部搜索栏 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 9999rpx;
  padding: 16rpx 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-card);
  gap: 16rpx;
}

.search-svg {
  color: var(--ink-muted);
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.clear-icon {
  color: var(--ink-muted);
  display: flex;
  align-items: center;
  padding: 4rpx;
}

/* 分类胶囊标签滚动 */
.category-scroll-wrap {
  margin-bottom: 24rpx;
}

.category-scroll {
  display: flex;
  gap: 14rpx;
  white-space: nowrap;
}

.cat-pill {
  padding: 12rpx 28rpx;
  border-radius: 9999rpx;
  background: #ffffff;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--border-card);
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.cat-pill:active {
  transform: scale(0.96);
}

.cat-active {
  background: var(--primary-gradient);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(143, 32, 46, 0.22);
}

/* 景点列表与卡片 */
.spots-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.spot-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-card);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.spot-card:active {
  transform: translateY(2rpx);
  box-shadow: var(--shadow-md);
}

.spot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.spot-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.spot-seal {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  background: var(--primary);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.spot-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.spot-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.spot-meta-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

.meta-item {
  background: var(--bg-page);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--border-card);
}

.tag-area {
  color: var(--gold-dark);
  background: var(--gold-light);
  border-color: var(--gold-border);
}

.spot-card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--bg-subtle);
}

.btn-spot-detail {
  background: var(--bg-subtle) !important;
  color: var(--text-secondary) !important;
  font-size: 24rpx !important;
  font-weight: 500 !important;
  border-radius: 9999rpx !important;
  padding: 10rpx 26rpx !important;
  border: 1rpx solid var(--border-card) !important;
  margin: 0 !important;
}

.btn-spot-ask {
  background: var(--primary-light) !important;
  color: var(--primary) !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  border-radius: 9999rpx !important;
  padding: 10rpx 26rpx !important;
  border: 1rpx solid var(--primary-border) !important;
  margin: 0 !important;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon-box {
  color: var(--ink-muted);
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
}
