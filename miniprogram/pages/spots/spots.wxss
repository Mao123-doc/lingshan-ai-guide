/** pages/spots/spots.wxss **/

.spots-container {
  padding-top: 16rpx;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  font-size: 28rpx;
  color: #9ca3af;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.clear-icon {
  color: #9ca3af;
  font-size: 28rpx;
  padding: 4rpx 10rpx;
}

/* 分类胶囊 */
.category-scroll-wrap {
  margin-bottom: 24rpx;
}

.category-scroll {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
}

.cat-pill {
  display: inline-flex;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: var(--text-secondary);
  border: 1rpx solid #e5e7eb;
}

.cat-pill.active {
  background: var(--primary-gradient);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(196, 29, 127, 0.2);
}

/* 景点卡片 */
.spots-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.spot-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid #f0f0f0;
}

.spot-card:active {
  background: #fdfdfe;
}

.spot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.spot-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.spot-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.spot-id-badge {
  font-size: 20rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.spot-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.spot-meta-row {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.spot-card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f4f6;
}

.btn-detail {
  background: #f9fafb !important;
  color: var(--text-secondary) !important;
  font-size: 22rpx !important;
  padding: 8rpx 20rpx !important;
  border-radius: 20rpx !important;
  border: 1rpx solid #e5e7eb !important;
  margin: 0 !important;
}

.btn-ask {
  background: var(--primary-light) !important;
  color: var(--primary) !important;
  font-size: 22rpx !important;
  padding: 8rpx 20rpx !important;
  border-radius: 20rpx !important;
  border: 1rpx solid var(--primary-border) !important;
  font-weight: 600 !important;
  margin: 0 !important;
}

.empty-wrap {
  text-align: center;
  padding: 100rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}
